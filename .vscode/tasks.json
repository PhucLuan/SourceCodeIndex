{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Build app image",
      "type": "shell",
      "command": "docker compose build app",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Run all tests",
      "type": "shell",
      "command": "docker compose run --rm app python -m pytest tests/ -v",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Docker: Run Phase 5 / 5A tests",
      "type": "shell",
      "command": "docker compose run --rm app python -m pytest tests/test_phase5.py tests/test_phase5a.py -v",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Docker: Run current test file",
      "type": "shell",
      "command": "docker compose run --rm app python -m pytest \"${relativeFile}\" -v",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
